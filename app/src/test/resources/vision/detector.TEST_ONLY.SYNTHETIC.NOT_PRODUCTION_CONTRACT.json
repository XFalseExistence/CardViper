  "outputs": [
    { "name": "boxes", "role": "DETECTION_BOXES", "shape": [1, 10, 4], "dtype": "FLOAT32" },
    { "name": "scores", "role": "DETECTION_SCORES", "shape": [1, 10], "dtype": "FLOAT32" },
    { "name": "classes", "role": "DETECTION_CLASSES", "shape": [1, 10], "dtype": "FLOAT32" },
    { "name": "count", "role": "DETECTION_COUNT", "shape": [1], "dtype": "FLOAT32" }
