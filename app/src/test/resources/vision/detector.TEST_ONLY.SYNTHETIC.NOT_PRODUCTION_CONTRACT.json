{
  "schema_version": 1,
  "model_kind": "DETECTOR",
  "artifact": { "sha256": "1111111111111111111111111111111111111111111111111111111111111111" },
  "input": { "name": "image", "shape": [1, 4, 4, 3], "layout": "NHWC", "dtype": "FLOAT32" },
